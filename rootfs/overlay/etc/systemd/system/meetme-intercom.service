[Unit]
Description=Fermax MEET intercom (SIP to the door panel, call window over the kiosk)
After=meetme-kiosk.service network-online.target screen-blank.service
Wants=network-online.target
# Restarting the kiosk (cage) breaks the Wayland connection, so the intercom restarts together with it
PartOf=meetme-kiosk.service

[Service]
User=kiosk
EnvironmentFile=/etc/default/meetme-intercom
# Call window in the kiosk's (cage) Wayland session
Environment=XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 GDK_BACKEND=wayland LANG=C.UTF-8
ExecStart=/usr/bin/python3 /usr/local/bin/meetme-intercom
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
