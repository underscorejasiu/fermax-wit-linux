# Fermax MEET intercom (meetme-intercom). installer/provision.sh fills in the values of your home
# from site/site.conf; see that file for what each one means.
PANEL_IP=
SCREENS=""
EXTRA_URLS=""
ROOM=1000001
PANEL_USER=10001000001
BUILD=1
UNIT=0
FLOOR=0
FAMILY=1
# Without SCREENS the list is fetched from the original master screen and this screen is added
#MASTER_IP=
# Heartbeat to the original master screen (it rejects new screens with 480, so off by default)
#HEARTBEAT=1
#DCODE=5
#SYNC=123456
PANEL_VIDEO_URL=
CAMERA_URL=
# Home Assistant webhook for meetme_intercom events: http://HA:8123/api/webhook/<id>
HA_WEBHOOK=
RING=/usr/local/share/meetme/ring4.wav
# Ring volume: 1.0 = original file
RING_VOLUME=0.5
